# Copy to .env (gitignored). NEVER commit real values.
#
# In TrueForge local mode, the model provider API key is configured in TrueForge's own UI,
# not here. This file documents any env the arena / MCP server may need.

# Arena subnet — must match arena/docker-compose.yml AND
# mcp-server/src/policy/networkPolicy.ts (ARENA_CIDRS_V4).
CRUCIBLE_ARENA_SUBNET=10.42.0.0/24

# Port the Crucible MCP server listens on (adjust to your setup).
CRUCIBLE_MCP_PORT=8848

# Do NOT put a real model key in the repo. Placeholder only, for reference:
# OPENAI_API_KEY=sk-REPLACE_ME
